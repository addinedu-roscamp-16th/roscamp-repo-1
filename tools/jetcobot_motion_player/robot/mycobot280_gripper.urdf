<?xml version="1.0"?>
<!-- myCobot 280 (JetCobot) + 닫힌 그리퍼. 맵 URDF 의 robot1_mount / robot2_mount 에 붙음 (maps/mapfile.py to_ros) -->
<robot name="mycobot280" base="g_base">
  <link name="g_base"><visual><origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 -0.000000 0.000000" /><geometry><mesh filename="meshes/link_g_base.stl" /></geometry><material name="robot"><color rgba="0.930 0.930 0.930 1.000" /></material></visual></link>
  <link name="joint1"><visual><origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 -0.000000 0.000000" /><geometry><mesh filename="meshes/link_joint1.stl" /></geometry><material name="robot"><color rgba="0.930 0.930 0.930 1.000" /></material></visual></link>
  <link name="joint2"><visual><origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 -0.000000 0.000000" /><geometry><mesh filename="meshes/link_joint2.stl" /></geometry><material name="robot"><color rgba="0.930 0.930 0.930 1.000" /></material></visual></link>
  <link name="joint3"><visual><origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 -0.000000 0.000000" /><geometry><mesh filename="meshes/link_joint3.stl" /></geometry><material name="robot"><color rgba="0.930 0.930 0.930 1.000" /></material></visual></link>
  <link name="joint4"><visual><origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 -0.000000 0.000000" /><geometry><mesh filename="meshes/link_joint4.stl" /></geometry><material name="robot"><color rgba="0.930 0.930 0.930 1.000" /></material></visual></link>
  <link name="joint5"><visual><origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 -0.000000 0.000000" /><geometry><mesh filename="meshes/link_joint5.stl" /></geometry><material name="robot"><color rgba="0.930 0.930 0.930 1.000" /></material></visual></link>
  <link name="joint6"><visual><origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 -0.000000 0.000000" /><geometry><mesh filename="meshes/link_joint6.stl" /></geometry><material name="robot"><color rgba="0.930 0.930 0.930 1.000" /></material></visual></link>
  <link name="joint6_flange"><visual><origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 -0.000000 0.000000" /><geometry><mesh filename="meshes/link_joint6_flange.stl" /></geometry><material name="robot"><color rgba="0.930 0.930 0.930 1.000" /></material></visual></link>
  <link name="gripper"><visual><origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 -0.000000 0.000000" /><geometry><mesh filename="meshes/gripper_closed.stl" /></geometry><material name="gripper"><color rgba="0.550 0.300 0.650 1.000" /></material></visual></link>
  <joint name="g_base_to_joint1" type="fixed"><parent link="g_base" /><child link="joint1" /><origin xyz="0 0 0" rpy="0 0 0" /><axis xyz="0 0 0" /><limit lower="-3.14" upper="3.14159" effort="1000.0" velocity="0" /></joint>
  <joint name="joint2_to_joint1" type="revolute"><parent link="joint1" /><child link="joint2" /><origin xyz="0 0 0.13156" rpy="0 0 0" /><axis xyz="0 0 1" /><limit lower="-2.9321" upper="2.9321" effort="1000.0" velocity="0" /></joint>
  <joint name="joint3_to_joint2" type="revolute"><parent link="joint2" /><child link="joint3" /><origin xyz="0 0  0" rpy="0 1.5708 -1.5708" /><axis xyz="0 0 1" /><limit lower="-2.4434" upper="2.4434" effort="1000.0" velocity="0" /></joint>
  <joint name="joint4_to_joint3" type="revolute"><parent link="joint3" /><child link="joint4" /><origin xyz="  -0.1104 0 0   " rpy="0 0 0" /><axis xyz=" 0 0 1" /><limit lower="-2.6179" upper="2.6179" effort="1000.0" velocity="0" /></joint>
  <joint name="joint5_to_joint4" type="revolute"><parent link="joint4" /><child link="joint5" /><origin xyz="-0.096 0 0.06462" rpy="0 0 -1.5708" /><axis xyz=" 0 0 1" /><limit lower="-2.6179" upper="2.6179" effort="1000.0" velocity="0" /></joint>
  <joint name="joint6_to_joint5" type="revolute"><parent link="joint5" /><child link="joint6" /><origin xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0" /><axis xyz="0 0 1" /><limit lower="-2.7052" upper="2.7925" effort="1000.0" velocity="0" /></joint>
  <joint name="joint6output_to_joint6" type="revolute"><parent link="joint6" /><child link="joint6_flange" /><origin xyz="0 0.0456 0" rpy="-1.5708 0 0" /><axis xyz="0 0 1" /><limit lower="-3.14159" upper="3.14159" effort="1000.0" velocity="0" /></joint>
  <joint name="flange_to_gripper" type="fixed"><parent link="joint6_flange" /><child link="gripper" /><origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 -0.000000 0.000000" /></joint>
</robot>
